# Copy to an uncommitted .env.local; do not put real values in chat or source code.
AI_GATEWAY_API_KEY=
# Select an exact text model ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=
# Keep disabled until credentials, request limits and budget controls are configured.
ENABLE_AI=false
# Set true ONLY after configuring WAF/shared rate limits and a provider budget.
AI_GUARDS_CONFIGURED=false
